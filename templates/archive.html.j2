{% extends "_base.html.j2" %}
{% block title %}Archive — Daily Espresso{% endblock %}
{% block description %}Every edition of the Daily Espresso.{% endblock %}

{% block body %}
<header class="mast">
  <div class="mast__top">
    <div class="mast__id">
      <div class="mast__edition">Back issues</div>
      <h1 class="mast__title"><a href="{{ root_prefix }}index.html">Daily Espresso</a></h1>
    </div>
    <div class="mast__meta">
      <div class="mast__date">{{ editions | length }} EDITION{{ '' if editions | length == 1 else 'S' }}</div>
      <div>Every morning, filed</div>
    </div>
  </div>
</header>

<section class="panel">
  {% if editions %}
    {% for edition in editions %}
    <a class="edition" href="{{ edition.href }}">
      <span class="edition__date">{{ edition.date_mast | default(edition.date) }}</span>
      <span class="edition__headline">{{ edition.headline or edition.date_long }}</span>
      <span class="edition__count">{{ edition.counts.stories | default(0) }} stories</span>
    </a>
    {% endfor %}
  {% else %}
    <p class="panel__empty">No editions yet.</p>
  {% endif %}
</section>
{% endblock %}

{% block foot_left %}ARCHIVE{% endblock %}
