{% extends "_base.html.j2" %}
{% import "_story.html.j2" as s %}
{% block title %}Daily Espresso — {{ issue.date_long }}{% endblock %}
{% block description %}{{ issue.masthead.tagline | default('Five things, no scrolling') }} — {{ issue.date_long }}.{% endblock %}

{% block body %}
<header class="mast">
  <div class="mast__top">
    <div class="mast__id">
      <div class="mast__edition">{{ issue.masthead.edition | default('Vol. I') }} — No. {{ issue.edition_no }}</div>
      <h1 class="mast__title"><a href="{{ root_prefix }}index.html">Daily Espresso</a></h1>
    </div>
    <div class="mast__meta">
      <div class="mast__date">{{ issue.date_mast }}</div>
      <div>{{ issue.masthead.tagline | default('Five things, no scrolling') }}</div>
    </div>
  </div>

  {% if issue.weather or issue.drill.cards %}
  <div class="strip">
    {% if issue.weather %}
    <div class="strip__weather">
      {% for place in issue.weather %}
      <span><strong class="strip__code">{{ place.code }}</strong> {{ place.high }}° / {{ place.low }}°{% if place.conditions %} · {{ place.conditions }}{% endif %}</span>
      {% endfor %}
    </div>
    {% endif %}
    {% if issue.drill.quiz %}
    <div>
      <span class="strip__label">MOT DU JOUR</span>
      <span class="strip__word">{{ issue.drill.quiz.fr }}</span>
      <span>— {{ issue.drill.quiz.en }}</span>
    </div>
    {% endif %}
  </div>
  {% endif %}
</header>

<div class="lead-row">
  {% set email = issue.sections.email_security %}
  <section class="panel panel--lead lead-row__main">
    <div class="panel__head">
      <h2 class="panel__title">{{ email.label }}</h2>
      <span class="panel__count">{{ '%02d' | format(email.stories | length) }} items</span>
    </div>
    {{ s.panel_body(email) }}

    {% if issue.kev %}
    <div class="inset">
      <div class="inset__head">
        <span>ACTIVELY EXPLOITED · CISA KEV</span>
        <span>LAST 14 DAYS</span>
      </div>
      <div class="kev">
        {% for vuln in issue.kev %}
        <div class="kev__row">
          <a class="kev__cve" href="{{ vuln.url }}" rel="noopener">{{ vuln.cve }}</a>
          <span class="kev__vendor">{{ vuln.vendor }} {{ vuln.product }}</span>
          {% if vuln.ransomware %}<span class="kev__flag">ransomware</span>{% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="inset__foot">REMEDIATE BY {{ issue.kev[0].due }}</div>
    </div>
    {% endif %}
  </section>

  {% if issue.rotating %}
  <section class="panel panel--dark lead-row__side">
    <div class="panel__head">
      <h2 class="panel__title">{{ issue.rotating.label }}</h2>
      <span class="panel__count">rotating slot</span>
    </div>
    {% if issue.rotating.days is not none and issue.rotating.days >= 0 %}
    <div class="count">
      <div class="count__n">{{ issue.rotating.days }}</div>
      <div class="count__caption">{{ issue.rotating.caption }}</div>
    </div>
    {% endif %}
    {% for entry in issue.rotating.entries %}
    {% if not loop.first %}<div class="rule"></div>{% endif %}
    <article class="story{% if loop.first %} story--lead{% endif %}">
      <h3 class="story__title">{{ entry.title }}</h3>
      <p class="story__body">{{ entry.body }}</p>
    </article>
    {% endfor %}
  </section>
  {% endif %}
</div>

<div class="grid-row">
  {% for key in ['ai', 'france'] %}
  {% set section = issue.sections[key] %}
  <section class="panel">
    <div class="panel__head">
      <h2 class="panel__title">{{ section.label }}</h2>
      <span class="panel__count">{{ '%02d' | format(section.stories | length) }}</span>
    </div>
    {{ s.panel_body(section) }}
  </section>
  {% endfor %}

  {% set hockey = issue.sections.nhl %}
  {% if issue.nhl.last_meeting or hockey.stories %}
  <section class="panel">
    <div class="panel__head">
      <h2 class="panel__title">{{ issue.nhl.label | default(hockey.label) }}</h2>
      <span class="panel__count">{{ 'OFFSEASON' if issue.nhl.offseason else 'IN SEASON' }}</span>
    </div>
    {% if issue.nhl.last_meeting %}
    {% set m = issue.nhl.last_meeting %}
    <div class="inset">
      <div class="inset__head">
        <span>LAST MEETING · {{ m.date | shortdate }}</span>
        <span>{{ m.venue | upper }}</span>
      </div>
      <div class="score">
        {% set away_won = m.away_score > m.home_score %}
        <span>{{ m.away }} <strong class="{{ 'score__win' if away_won else 'score__lose' }}">{{ m.away_score }}</strong></span>
        <span class="score__slash">/</span>
        <span>{{ m.home }} <strong class="{{ 'score__lose' if away_won else 'score__win' }}">{{ m.home_score }}</strong></span>
        {% if m.overtime %}<span class="score__ot">{{ m.period }}</span>{% endif %}
      </div>
      <div class="inset__foot">
        {% if issue.nhl.next_game %}
        NEXT · {{ issue.nhl.next_game.date | shortdate }} · {{ issue.nhl.next_game.away }} @ {{ issue.nhl.next_game.home }}
        {% else %}
        NEXT GAME · TBD
        {% endif %}
      </div>
    </div>
    {% endif %}
    {{ s.panel_body(hockey) }}
  </section>
  {% endif %}

  {% set tennis = issue.tennis %}
  {% set tennis_news = issue.sections.tennis %}
  {% if tennis.following or tennis_news.stories %}
  <section class="panel">
    <div class="panel__head">
      <h2 class="panel__title">{{ tennis.label | default('Tennis') }}</h2>
      <span class="panel__count">
        {%- if tennis.events -%}{{ tennis.events[0].name | upper }}{%- else -%}OFF TOUR{%- endif -%}
      </span>
    </div>

    {% for player in tennis.following %}
    <div class="inset">
      <div class="inset__head">
        <span>{{ player.name | upper }}</span>
        {% if player.last %}<span>{{ player.last.round | upper }}</span>{% endif %}
      </div>
      {% if player.last %}
      <div class="match">
        {% for side in player.last.players %}
        <div class="match__row{% if side.winner %} match__row--won{% endif %}">
          <span class="match__name">{{ side.name }}</span>
          <span class="match__sets">{% for set in side.sets %}<span>{{ set | int }}</span>{% endfor %}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if player.next %}
      <div class="inset__foot">
        NEXT · {{ player.next.round | upper }} · {{ player.next.opponent | default('TBD', true) }}
        {%- if player.next.date %} · {{ player.next.date | shortdate }}{% endif %}
      </div>
      {% endif %}
    </div>
    {% endfor %}

    {% if tennis.rankings %}
    <div class="ranks">
      {% for tour, ranks in tennis.rankings.items() %}
      <div class="ranks__tour">
        <div class="ranks__label">{{ tour }}</div>
        {% for entry in ranks %}
        <div class="ranks__row"><span class="ranks__n">{{ entry.rank }}</span> {{ entry.name }}</div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if tennis.upcoming %}
    <div class="upnext">
      <div class="upnext__label">NEXT ON TOUR</div>
      {% for event in tennis.upcoming %}
      <div class="upnext__row">
        <span class="upnext__name">{{ event.name }}</span>
        <span class="upnext__date">{{ event.start | shortdate }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if tennis_news.stories %}
    <div class="rule"></div>
    {{ s.panel_body(tennis_news) }}
    {% endif %}
  </section>
  {% endif %}
</div>
{% endblock %}

{% block foot_left %}ASSEMBLED {{ issue.date_mast }} · {{ issue.sources_line }}{% endblock %}
